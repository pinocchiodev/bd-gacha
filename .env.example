# ===== ต้องตั้งค่า =====
# วันเกิดของ Zend รูปแบบ DDMMYYYY (ค.ศ.) เช่น 14021998
ZEND_PASSWORD=14021998

# รหัสสำหรับคุณ (ล็อคอินด้วยชื่อ admin) ไว้ทดสอบ + รีเซ็ตผลสุ่ม
ADMIN_PASSWORD=change-me

# สตริงสุ่มยาวๆ ใช้เซ็นคุกกี้ล็อคอิน (พิมพ์มั่วๆ ยาว 32+ ตัวอักษร)
SESSION_SECRET=please-change-this-to-a-long-random-string

# ===== Redis (เก็บผลสุ่มถาวร) =====
# ถ้าเชื่อม Upstash ผ่าน Vercel Marketplace ตัวแปรเหล่านี้จะถูกเติมให้อัตโนมัติ
# (ระบบรองรับทั้งชื่อ KV_REST_API_* และ UPSTASH_REDIS_REST_*)
KV_REST_API_URL=
KV_REST_API_TOKEN=
